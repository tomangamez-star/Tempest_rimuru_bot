# Rimuru Tempest Casino Bot — environment configuration
# Copy to .env and fill in. NEVER commit .env

# Telegram bot token from @BotFather (REQUIRED)
TELEGRAM_TOKEN=

# Owner Telegram ID (numeric) — owner is the "King", never robbed/heisted (REQUIRED)
OWNER_ID=

# Groq API key for Rimuru AI — https://console.groq.com (REQUIRED for Rimuru chat)
GROQ_API_KEY=

# Runtime
PORT=10000
NODE_ENV=production

# Storage (relative path → DB auto-created in ./data, no disk mount needed.
# Works on Render FREE tier. For persistence on Starter+, mount a disk and set
# DB_PATH=/data/rimuru.db and DATA_DIR=/data.)
DB_PATH=./data/rimuru.db
DATA_DIR=./data

# Telegram polling settings
ALLOWED_UPDATES=messages,callback_query