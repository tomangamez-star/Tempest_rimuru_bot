# ── EXTERNAL POSTGRES (Supabase) — DURABLE PERSISTENCE ──────────────────────
# Balances/leaderboard/mods SURVIVE redeploys only with an external DB.
# Set this on Render (Dashboard → Environment) to a Supabase Postgres URL:
#
#   🟢 SESSION POOLER (RECOMMENDED — use this one):
#     postgresql://postgres:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
#     (has ?sslmode=require — the bot auto-enables TLS for supabase.co hosts)
#
#   🟡 DIRECT CONNECTION (use only if the pooler is unavailable):
#     postgresql://postgres:[YOUR-PASSWORD]@db.<your-ref>.supabase.co:5432/postgres
#     ⚠ Supabase FREE tier often BLOCKS direct IPv6 connections on :5432 —
#     if /health or logs show Postgres unreachable, switch to the pooler.
#
# URL-encode special characters in the password, e.g. %20 for spaces.
# No DATABASE_URL → bot runs SQLite-only (data resets on redeploy).
DATABASE_URL=
# Scraper-worker only (normally configure as a GitHub Actions secret, not on
# Render). Obtain it with /chatid in Rimuru's private archive after deploy.
SHOOB_ARCHIVE_CHAT_ID=
# Render only: fine-grained GitHub PAT used by owner-only /scrapestart.
# Repository access: Tempest_rimuru_bot; permissions: Actions read/write,
# Metadata read. Never commit the real token.
GITHUB_ACTIONS_TOKEN=
# Optional overrides; defaults already match Rimuru's repository/workflow.
GITHUB_REPOSITORY=tomangamez-star/Tempest_rimuru_bot
GITHUB_SHOOB_WORKFLOW=shoob-archive.yml
GITHUB_WORKFLOW_REF=main
# Optional: how often local changes are mirrored to Postgres (ms)
DB_SYNC_INTERVAL_MS=1500
# Heap headroom for the Node process — prevents OOM crashes on Render free
# tier (default V8 heap ~512MB caused "heap out of memory" after ~20 min).
# The start script already sets --max-old-space-size=512; raise if the bot
# grows large (e.g. 1024).
NODE_OPTIONS=--max-old-space-size=512
# Auto-backup runs every 5 minutes (flat interval), keeping the last 5 GOOD
# snapshots + SUSPECT regression detection. AUTO_BACKUP_CHECK_MS is the
# scheduler tick (default 30s); a backup is due every 5 minutes.
AUTO_BACKUP_CHECK_MS=30000



# \u2500\u2500 ONE-TIME DATA MIGRATION (SQLite \u2192 Postgres) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
# If you have an existing SQLite DB with balances you want to keep, migrate it
# into the Postgres DB ONCE (idempotent \u2014 safe to re-run):
#   DATABASE_URL="postgresql://user:pass@host:5432/db" node scripts/migrate-sqlite-to-pg.js
# Options: --sqlite <path> (default ./data/rimuru.db) \u00b7 --dry-run (preview only)
# NOTE: on Render FREE tier the SQLite file is ephemeral \u2014 if a redeploy wiped
# it, the old data is unrecoverable and there is nothing to migrate. Run this
# from your local machine or a Render Shell BEFORE the DB is wiped.

# Telegram polling settings
ALLOWED_UPDATES=messages,callback_query

# Rimuru stickers — public sticker pack name sent with Rimuru replies.
# Unset or invalid → stickers skipped gracefully (bot never crashes).
STICKER_PACK=Tensei_Shitara_Slime_Datta_Ken2

# Per-game cooldown in ms (each game individually, per user).
# No global gambling cooldown — switching games is always instant.
PER_GAME_COOLDOWN_MS=120000
# /shunt Special Hunt uses Danbooru public read-only JSON.
# No API token, account, or Render environment variable is required.

# Optional JTF Signature precision mask. Signature has a conservative local
# flat-background path, but complex scene artwork needs remove.bg for the clean
# transparent head/hair escape effect.
REMOVEBG_API_KEY=

# Renderer 4 uses the existing GROQ_API_KEY to inspect artwork and return a
# text-free design blueprint. Without a key it stays functional using Rimuru's
# deterministic local theme engine.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
