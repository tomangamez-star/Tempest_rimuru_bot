# Rimuru Tempest Casino Bot — environment configuration
# Copy to .env and fill in. NEVER commit .env

# Telegram bot token from @BotFather (REQUIRED)
TELEGRAM_TOKEN=

# Owner Telegram ID (numeric) — owner is the "King", never robbed/heisted (REQUIRED)
OWNER_ID=

# Groq API key for Rimuru AI — https://console.groq.com (REQUIRED for Rimuru chat)
GROQ_API_KEY=

# Runtime
PORT=10000
NODE_ENV=production

# Storage (relative path → DB auto-created in ./data, no disk mount needed.
# Works on Render FREE tier. For persistence on Starter+, mount a disk and set
# DB_PATH=/data/rimuru.db and DATA_DIR=/data.)
DB_PATH=./data/rimuru.db
DATA_DIR=./data

# ── EXTERNAL POSTGRES (Supabase) — DURABLE PERSISTENCE ──────────────────────
# Balances/leaderboard/mods SURVIVE redeploys only with an external DB.
# Set this on Render (Dashboard → Environment) to a Supabase Postgres URL:
#   postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres
# (for Supabase, use the "Session pooler" connection string; URL-encode any
# special chars in the password, e.g. %20 for spaces).
# No DATABASE_URL → bot runs SQLite-only (data resets on redeploy).
DATABASE_URL=
# Optional: how often local changes are mirrored to Postgres (ms)
DB_SYNC_INTERVAL_MS=1500

# Telegram polling settings
ALLOWED_UPDATES=messages,callback_query

# Rimuru stickers — public sticker pack name sent with Rimuru replies.
# Unset or invalid → stickers skipped gracefully (bot never crashes).
STICKER_PACK=Tensei_Shitara_Slime_Datta_Ken2

# Per-game cooldown in ms (each game individually, per user).
# No global gambling cooldown — switching games is always instant.
PER_GAME_COOLDOWN_MS=120000